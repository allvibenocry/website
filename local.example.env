# The deploy scripts' local configuration (D14).
#
# Copy this file to local.env, which is gitignored, and fill in your own values
# there. This repository is public: it never holds an address, a host name, a
# user or an id of the network it is deployed on. Every value below is a
# placeholder, and 192.0.2.0/24 is a range reserved for documentation.
#
# A variable already set in the environment wins over this file.
#
# Secrets do not go here. PORTAINER_TOKEN is read from the environment only
# (rule 3); scripts/stack.mjs ignores it in this file and says so.

# Where Portainer answers.
PORTAINER_URL=https://portainer.example:9443

# The Portainer environment the site runs in. Leave empty when Portainer has
# only one.
PORTAINER_ENDPOINT_ID=

# user@host of the production Docker host, for read-only checks over SSH with a
# key (BatchMode=yes: a missing key fails instead of asking for a password).
VIKT_HOST=deploy@docker-host.example

# The production host's LAN IPv4 address, and the port the site is published on.
WEB_BIND=192.0.2.10
WEB_PORT=8080
